{
  "entities": {
    "Registration": {
      "title": "Registration",
      "description": "Data pendaftaran siswa baru les privat Bright Future Kabupaten Magelang",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "description": "Nomor identitas unik pendaftaran siswa",
          "maxLength": 64
        },
        "studentName": {
          "type": "string",
          "description": "Nama lengkap calon siswa",
          "maxLength": 128
        },
        "level": {
          "type": "string",
          "description": "Jenjang bimbingan belajar",
          "enum": ["calistung", "tk", "sd", "smp", "sma"]
        },
        "parentName": {
          "type": "string",
          "description": "Nama orang tua atau wali murid",
          "maxLength": 128
        },
        "whatsapp": {
          "type": "string",
          "description": "Nomor WhatsApp aktif wali murid",
          "maxLength": 32
        },
        "homeAddress": {
          "type": "string",
          "description": "Alamat lengkap kunjungan tutor di Kab. Magelang",
          "maxLength": 500
        },
        "selectedSchedule": {
          "type": "array",
          "description": "Slot hari dan jam les yang dipilih"
        },
        "totalSessions": {
          "type": "number",
          "description": "Total sesi paket bimbingan belajar (contoh: 8 sesi bulanan)"
        },
        "totalAmount": {
          "type": "number",
          "description": "Total nominal investasi SPP bulanan"
        },
        "appliedDiscount": {
          "type": "number",
          "description": "Nominal potongan diskon paket"
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Nomor tagihan invoice pendaftaran",
          "maxLength": 64
        },
        "paymentStatus": {
          "type": "string",
          "description": "Status pembayaran pendaftaran",
          "enum": ["pending", "paid", "verified"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pendaftaran dikirimkan"
        }
      },
      "required": [
        "studentId",
        "studentName",
        "level",
        "parentName",
        "whatsapp",
        "homeAddress",
        "totalSessions",
        "totalAmount",
        "invoiceNumber",
        "paymentStatus",
        "createdAt"
      ]
    },
    "AdminCredential": {
      "title": "AdminCredential",
      "description": "Kredensial akun admin operasional Bright Future yang tersimpan di Firestore",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Alamat email login resmi admin",
          "maxLength": 128
        },
        "password": {
          "type": "string",
          "description": "Kata sandi akun admin",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Nama pengelola atau super admin",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Peran hak akses sistem",
          "enum": ["super_admin", "admin", "finance", "academic"]
        },
        "lastLogin": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp login terakhir kali"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp pembaruan kredensial"
        }
      },
      "required": ["email", "password", "role"]
    },
    "PortalCredential": {
      "title": "PortalCredential",
      "description": "Kredensial akun multi-peran (tutor, siswa, orang tua) di Firestore",
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "description": "ID Siswa, email, atau nomor WhatsApp pengguna",
          "maxLength": 128
        },
        "password": {
          "type": "string",
          "description": "Kata sandi masuk portal",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Peran pengguna dalam sistem",
          "enum": ["admin", "tutor", "siswa", "orang_tua"]
        },
        "name": {
          "type": "string",
          "description": "Nama lengkap pemilik akun",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan akun"
        }
      },
      "required": ["identifier", "password", "role"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Data tagihan dan invoice pembayaran bimbingan belajar siswa (paket dan non-paket)",
      "type": "object",
      "properties": {
        "inv": {
          "type": "string",
          "description": "Nomor invoice unik tagihan (contoh: BF-INV-2026-09-088)",
          "maxLength": 64
        },
        "parent": {
          "type": "string",
          "description": "Nama orang tua / wali murid penerima tagihan",
          "maxLength": 128
        },
        "studentName": {
          "type": "string",
          "description": "Nama siswa peserta bimbingan belajar",
          "maxLength": 128
        },
        "packageType": {
          "type": "string",
          "description": "Tipe paket tagihan: paket reguler atau non_paket fleksibel",
          "enum": ["paket", "non_paket"]
        },
        "package": {
          "type": "string",
          "description": "Nama paket les atau label tagihan",
          "maxLength": 128
        },
        "channel": {
          "type": "string",
          "description": "Kanal pembayaran yang dipilih (Midtrans QRIS, VA BCA/Mandiri, dll)",
          "maxLength": 128
        },
        "amount": {
          "type": "number",
          "description": "Total nominal tagihan dalam Rupiah"
        },
        "status": {
          "type": "string",
          "description": "Status pembayaran tagihan invoice",
          "enum": ["LUNAS", "PENDING", "TERLAMBAT (H+2)", "TERLAMBAT"]
        },
        "date": {
          "type": "string",
          "description": "Keterangan tanggal tagihan atau jatuh tempo",
          "maxLength": 64
        },
        "periodMonth": {
          "type": "string",
          "description": "Periode bulan bimbingan (khusus non paket, contoh: September 2026)",
          "maxLength": 64
        },
        "meetingDates": {
          "type": "array",
          "description": "Daftar tanggal pertemuan sesi les (khusus non paket)"
        },
        "meetingDatesRaw": {
          "type": "string",
          "description": "Input mentah angka tanggal dipisahkan koma",
          "maxLength": 256
        },
        "costPerMeeting": {
          "type": "number",
          "description": "Tarif biaya per sesi pertemuan (khusus non paket)"
        },
        "totalMeetings": {
          "type": "number",
          "description": "Jumlah total sesi pertemuan les yang ditagihkan"
        },
        "whatsapp": {
          "type": "string",
          "description": "Nomor WhatsApp aktif wali untuk pengiriman tagihan",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu penerbitan invoice"
        }
      },
      "required": ["inv", "parent", "packageType", "package", "channel", "amount", "status", "date"]
    }
  },
  "firestore": {
    "/registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Koleksi data pendaftaran siswa baru les privat"
    },
    "/admin_credentials/{credId}": {
      "schema": "AdminCredential",
      "description": "Koleksi kredensial login admin dan otentikasi database"
    },
    "/portal_credentials/{credId}": {
      "schema": "PortalCredential",
      "description": "Koleksi akun dan kredensial multi-role portal"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Koleksi data tagihan dan invoice pembayaran bimbingan belajar siswa"
    }
  }
}
